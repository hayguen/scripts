function glg {
  # %<(25,trunc)  legt Breit fuer folgendes Feld fest
  # %x09   waere Tabulator-Byte
  # https://git-scm.com/docs/pretty-formats
  if [ -z "$1" ]; then
    git log --date="format-local:%a %Y-%m-%d %H:%M:%S" --pretty=format:"%<(12,trunc)%h %<(19,trunc)%an %<(23,trunc)%ad %s" -20 | nl
  else
    git log --date="format-local:%a %Y-%m-%d %H:%M:%S" --pretty=format:"%<(12,trunc)%h %<(19,trunc)%an %<(23,trunc)%ad %s" "$@" | nl
  fi
}

function glgx {
  # with additional commit date
  if [ -z "$1" ]; then
    git log --date="format-local:%a %Y-%m-%d %H:%M:%S" --pretty=format:"%<(12,trunc)%h %<(19,trunc)%an %<(23,trunc)%ad %<(23,trunc)%cd %s" -20 | nl
  else
    git log --date="format-local:%a %Y-%m-%d %H:%M:%S" --pretty=format:"%<(12,trunc)%h %<(19,trunc)%an %<(23,trunc)%ad %<(23,trunc)%cd %s" "$@" | nl
  fi
}

function gsa {
  # alias gsa='git stash apply'
  # alias gsa 0='git stash apply stash@{0}'
  # alias gsa 1='git stash apply stash@{1}'
  if [ -z "$1" ]; then
    echo "Error: missing parameter <n> or stash@{<n>}"
    echo "Function: git stash apply stash@{<n>}"
    echo "Usage: gsa <n>"
  else
    if [ "$1" -eq "$1" ] 2>/dev/null; then
      git stash apply stash@{$1}
    else
      git stash apply "$@"
    fi
  fi
}

function gsd {
  # alias gsd='git stash drop'
  # alias gsd 0='git stash drop stash@{0}'
  # alias gsd 1='git stash drop stash@{1}'
  if [ -z "$1" ]; then
    echo "Error: missing parameter <n> or stash@{<n>}"
    echo "Function: git stash drop stash@{<n>}"
    echo "Usage: gsd <n>"
  else
    if [ "$1" -eq "$1" ] 2>/dev/null; then
      git stash drop stash@{$1}
    else
      git stash drop "$@"
    fi
  fi
}

function gmeld {
  git difftool -y -t meld "$@"
}

