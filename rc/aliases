function gsa {
  # alias gsa='git stash apply'
  # alias gsa 0='git stash apply stash@{0}'
  # alias gsa 1='git stash apply stash@{1}'
  if [ -z "$1" ]; then
    echo "Error: missing parameter <n> or stash@{<n>}"
    echo "Function: git stash apply stash@{<n>}"
    echo "Usage: gsa <n>"
  else
    if [ "$1" -eq "$1" ] 2>/dev/null; then
      git stash apply stash@{$1}
    else
      git stash apply "$@"
    fi
  fi
}

function gsd {
