function gsshowdtd {
  # git difftool -d stash@{1}^1 stash@{1}
  if [ -z "$1" ]; then
    echo "Error: missing parameter <n> or stash@{<n>}"
    echo "Function: g dt -d .. == git difftool -d stash@{<n>}^1 stash@{<n>}"
    echo "Usage: gsshowdtd <n>"
  else
    if [ "$1" -eq "$1" ] 2>/dev/null; then
      git difftool -d stash@{$1}^1 stash@{$1}
    else
      git difftool -d "$@"
    fi
  fi
}


function gmeld {
  git difftool -y -t meld "$@"
}

