down_x_space () {
  if [ -z "$1" ]; then
    echo "Space URL missing! e.g. https://x.com/i/spaces/1qKDzWjajOOJV"
  else
    # $HOME/github/xspacedownloader/cli.py  "$1"  2>&1 |grep -v "for reading$"
    $HOME/bin/down_x_space  "$1"  2>&1 |grep -v "for reading$"
  fi
}

