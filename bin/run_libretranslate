#!/bin/bash

S="$(readlink -nf "$BASH_SOURCE")"
D="$(dirname "$S")"

# https://docs.libretranslate.com/
# https://www.youtube.com/watch?v=JKpGDF9FceI

if [ "$1" == "setup" ]; then
    # https://docs.libretranslate.com/
    # https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html
    sudo apt-get update && sudo apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       gnupg2

    curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | sudo gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg \
      && curl -s -L https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | \
        sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
        sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list

    sudo sed -i -e '/experimental/ s/^#//g' /etc/apt/sources.list.d/nvidia-container-toolkit.list
    sudo apt-get update
    export NVIDIA_CONTAINER_TOOLKIT_VERSION=1.20.1-1
      sudo apt-get install -y \
          nvidia-container-toolkit=${NVIDIA_CONTAINER_TOOLKIT_VERSION} \
          nvidia-container-toolkit-base=${NVIDIA_CONTAINER_TOOLKIT_VERSION} \
          libnvidia-container-tools=${NVIDIA_CONTAINER_TOOLKIT_VERSION} \
          libnvidia-container1=${NVIDIA_CONTAINER_TOOLKIT_VERSION}

    # https://docs.libretranslate.com/guides/installation/

    pip install libretranslate

    echo "upgrade with:  pip install -U libretranslate"
    # https://docs.libretranslate.com/guides/api_usage/

    "echo run again - without 'setup' argument"

elif [ "$1" == "stop" ]; then

    screen -XS libretranslate quit

elif [ "$1" == "status" ]; then

    R=$(screen -ls |grep -c libretranslate)
    if [ $R -gt 0 ]; then
        echo "libretranslate session is running"
        exit 0
    else
        echo "libretranslate session is NOT running"
        exit 1
    fi

elif [ "$1" == "start" ]; then

    source "$D/.env"
    if [ -z "${LT_HOST}" ]; then
        echo "LT_HOST not set in .env"
        LT_HOST="127.0.0.1"
        echo "using ${LT_HOST}"
    else
        echo "read LT_HOST = '${LT_HOST}'"
    fi
    if [ -z "${LT_SSL}" ] || [ "${LT_SSL}" == "0" ]; then
        echo "LT_SSL not set in .env"
        LT_PRE="http"
        LT_SSL_OPT=""
    else
        LT_PRE="https"
        LT_SSL_OPT="--ssl"
    fi
    if [ -z "${LT_DBG}" ] || [ "${LT_DBG}" == "0" ]; then
        echo "LT_DBG not set in .env"
        LT_DBG_OPT=""
    else
        LT_DBG_OPT="--debug"
    fi

    export LT_HOST
    export LT_SSL_OPT
    export LT_DBG_OPT

    R=$(screen -ls |grep -c libretranslate)
    if [ $R -gt 0 ]; then
        echo "libretranslate session is already running"
    else
        echo "libretranslate session is NOT running"
        screen -dmS libretranslate  bash --init-file ~/rc/rc-voicedet_python -c libretranslate --host "${LT_HOST}" ${LT_DBG_OPT} ${LT_SSL_OPT} --load-only "en,de,fr"  # ,ar,nl,he,hu,ru,es,tr,uk
        echo "now running  libretranslate --load-only en,de,fr"  # en,de,fr,tr,ru,ar,nl,he,hu,es,uk"
    fi

    echo "browse to  ${LT_PRE}://${LT_HOST}:5000"
    xdg-open "${LT_PRE}://${LT_HOST}:5000"

else

    echo "usage:  run_libretranslate [start|stop|status|setup]"

fi

exit 0


# Downloading Albanian → English (1.9) ...
# Downloading Arabic → English (1.0) ...
